{
  // Yalnız lokal geliştirme — prod'da compose env: ConnectionStrings__Postgres / __Redis, R2__*.
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=videoedit;Username=app;Password=devpassword",
    // RedisJobProgressPublisher her progress DB yazımının yanında 'job-progress' kanalına
    // publish eder (API forwarder'ı hub'a iletir). Redis kapalıysa yayın sessizce düşer,
    // DB yazımı ve istemcinin polling yedeği aynen çalışır — Redis zorunlu DEĞİLDİR.
    "Redis": "localhost:6379"
  },
  // Dev'de R2 yerine MinIO (compose.dev.yml) — reaper'ın AbortMultipartUpload'ı için.
  "R2": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKeyId": "videoedit",
    "SecretAccessKey": "devpassword123",
    "Bucket": "videoedit-media",
    "ExportsBucket": "videoedit-exports"
  }
}
