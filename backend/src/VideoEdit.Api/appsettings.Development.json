{
  // Yalnız lokal geliştirme. Prod'da bu değerler compose env'den gelir:
  //   ConnectionStrings__Postgres, ConnectionStrings__Redis, Jwt__Secret
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=videoedit;Username=app;Password=devpassword",
    // RedisProgressForwarder bu kanaldan worker'ın 'job-progress' publish'ini dinler ve
    // /hubs/progress gruplarına iletir. Redis kapalıysa API yine açılır (forwarder artan
    // aralıkla dener), istemci polling yedeğiyle çalışır — Redis zorunlu DEĞİLDİR.
    "Redis": "localhost:6379"
  },
  "Jwt": {
    // Dev-only secret (>= 32 karakter). PROD'DA ASLA — env: Jwt__Secret.
    "Secret": "dev-only-videoedit-jwt-secret-0123456789abcdef"
  },
  // Dev'de R2 yerine MinIO (compose.dev.yml). ServiceUrl set olduğunda AccountId kullanılmaz.
  "R2": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKeyId": "videoedit",
    "SecretAccessKey": "devpassword123",
    "Bucket": "videoedit-media",
    "ExportsBucket": "videoedit-exports"
  }
}
