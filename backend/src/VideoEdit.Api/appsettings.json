{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    // Secret prod'da env'den gelir (Jwt__Secret); dev değeri appsettings.Development.json'da.
    "Issuer": "videoedit",
    "Audience": "videoedit",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  // R2 prod'da env'den gelir: R2__AccountId, R2__AccessKeyId, R2__SecretAccessKey,
  // R2__Bucket, R2__ExportsBucket (compose.yml). Dev değerleri appsettings.Development.json'da.
  "Quotas": {
    "MaxTotalBytesPerUser": 21474836480,
    "MaxFileSizeBytes": 4294967296,
    "MaxConcurrentUploads": 5
  }
}
