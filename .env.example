# compose.yml icin ortam degiskenleri. Kopyala: cp .env.example .env
# .env dosyasini ASLA commit etme (.gitignore'da olmali).

# Uygulamanin domain'i (Caddy otomatik HTTPS icin — DNS A kaydi VPS'e isaret etmeli)
DOMAIN=app.example.com

# PostgreSQL 'app' kullanicisinin sifresi (guclu, rastgele bir deger uret)
PG_PASSWORD=change-me

# JWT imzalama anahtari (HS256). URETIM NOTU: en az 256-bit rastgele deger kullan:
#   openssl rand -base64 32
JWT_SECRET=change-me-256-bit-random

# Cloudflare R2 (S3 API) — Cloudflare dashboard > R2 > API Tokens
# Endpoint: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Medya bucket'i (orijinaller + proxy/filmstrip/waveform turevleri)
R2_BUCKET=videoedit-media-prod

# Export ciktilari icin ayri bucket (30 gun TTL lifecycle kurali onerilir)
R2_EXPORTS_BUCKET=videoedit-exports-prod
